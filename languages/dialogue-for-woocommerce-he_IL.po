#. Plugin Name of the plugin
#: dialogue-for-woocommerce.php
#: includes/class-dialogue-wc-admin.php:51
msgid "Dialogue for WooCommerce"
msgstr "Dialogue ל-WooCommerce"

#. Plugin URI of the plugin
#: dialogue-for-woocommerce.php
msgid "https://nowdialogue.com/woocommerce"
msgstr ""

#. Description of the plugin
#: dialogue-for-woocommerce.php
msgid "Connects your WooCommerce store to Dialogue: AI shopping assistant, product recommendations, Reels and A/B tests. One click to connect, products and orders sync automatically."
msgstr "מחבר את חנות ה-WooCommerce שלך ל-Dialogue: עוזר קניות מבוסס AI, המלצות מוצרים, רילס ובדיקות A/B. חיבור בלחיצה אחת, המוצרים וההזמנות מסתנכרנים אוטומטית."

#. Author of the plugin
#: dialogue-for-woocommerce.php
#: includes/class-dialogue-wc-admin.php:70
#: includes/class-dialogue-wc-admin.php:335
msgid "Dialogue"
msgstr "Dialogue"

#. Author URI of the plugin
#: dialogue-for-woocommerce.php
msgid "https://nowdialogue.com"
msgstr ""

#: includes/class-dialogue-wc-admin.php:43
msgid "This store uses Dialogue (nowdialogue.com) for product recommendations, a shopping assistant and A/B tests."
msgstr "החנות משתמשת ב-Dialogue (nowdialogue.com) להמלצות מוצרים, עוזר קניות ובדיקות A/B."

#: includes/class-dialogue-wc-admin.php:44
msgid "Dialogue's script sets first-party cookies (dai_v_h, dai_v_s) with a random visitor id and session id, used to recognise returning visitors and to connect orders to Dialogue visits. If the store uses a consent banner that supports the WP Consent API, these cookies are only set after the visitor allows statistics cookies."
msgstr "הסקריפט של Dialogue שומר עוגיות צד ראשון (dai_v_h, dai_v_s) עם מזהה מבקר ומזהה ביקור אקראיים, כדי לזהות מבקרים חוזרים ולקשר הזמנות לביקורים ב-Dialogue. אם בחנות יש באנר הסכמה שתומך ב-WP Consent API, העוגיות נשמרות רק אחרי שהמבקר אישר עוגיות סטטיסטיקה."

#: includes/class-dialogue-wc-admin.php:45
msgid "When an order is paid, the store sends Dialogue the order number, status, totals, currency, coupon codes, the products bought (ids, names, quantities, prices), the random visitor id and whether the order was placed on mobile or desktop. Names, email addresses, phone numbers, addresses and IP addresses are not sent."
msgstr "כשהזמנה משולמת, החנות שולחת ל-Dialogue את מספר ההזמנה, הסטטוס, הסכומים, המטבע, קודי הקופון, המוצרים שנקנו (מזהים, שמות, כמויות, מחירים), מזהה המבקר האקראי והאם ההזמנה בוצעה מנייד או ממחשב. שמות, אימיילים, טלפונים, כתובות וכתובות IP לא נשלחים."

#. translators: %s: privacy policy URL
#: includes/class-dialogue-wc-admin.php:48
#, php-format
msgid "Dialogue privacy policy: %s"
msgstr "מדיניות הפרטיות של Dialogue: %s"

#: includes/class-dialogue-wc-admin.php:93
msgid "Settings"
msgstr "הגדרות"

#: includes/class-dialogue-wc-admin.php:112
msgid "Dialogue is installed but not connected yet."
msgstr "Dialogue מותקן אבל עדיין לא מחובר."

#: includes/class-dialogue-wc-admin.php:114
msgid "Connect now"
msgstr "לחיבור עכשיו"

#: includes/class-dialogue-wc-admin.php:126
msgid "You do not have permission to do this."
msgstr "אין לך הרשאה לבצע פעולה זו."

#: includes/class-dialogue-wc-admin.php:176
#: includes/class-dialogue-wc-admin.php:243
msgid "Unexpected answer from Dialogue."
msgstr "התקבלה תשובה לא צפויה מ-Dialogue."

#. translators: %s: error
#: includes/class-dialogue-wc-admin.php:178
#, php-format
msgid "Could not start the connection: %s"
msgstr "לא ניתן להתחיל את החיבור: %s"

#: includes/class-dialogue-wc-admin.php:184
msgid "Could not start the connection: unexpected Dialogue address."
msgstr "לא ניתן להתחיל את החיבור: כתובת Dialogue לא צפויה."

#. translators: %s: error
#: includes/class-dialogue-wc-admin.php:246
#, php-format
msgid "Could not finish the connection: %s"
msgstr "לא ניתן להשלים את החיבור: %s"

#: includes/class-dialogue-wc-admin.php:261
msgid "Connected to Dialogue. Products are being imported."
msgstr "מחובר ל-Dialogue. המוצרים מיובאים עכשיו."

#: includes/class-dialogue-wc-admin.php:292
msgid "Disconnected from Dialogue."
msgstr "החיבור ל-Dialogue נותק."

#: includes/class-dialogue-wc-admin.php:304
msgid "Your store is connected to Dialogue. Products are being imported; this can take a few minutes."
msgstr "החנות שלך מחוברת ל-Dialogue. המוצרים מיובאים; זה יכול לקחת כמה דקות."

#: includes/class-dialogue-wc-admin.php:305
msgid "Access was not approved, so the store is not connected. Click \"Connect to Dialogue\" to try again."
msgstr "הגישה לא אושרה, ולכן החנות לא חוברה. לחצו על \"חיבור ל-Dialogue\" כדי לנסות שוב."

#: includes/class-dialogue-wc-admin.php:306
msgid "Please finish logging in to Dialogue (and choosing a plan), then click \"Connect to Dialogue\" again."
msgstr "השלימו את ההתחברות ל-Dialogue (ואת בחירת התוכנית), ואז לחצו שוב על \"חיבור ל-Dialogue\"."

#: includes/class-dialogue-wc-admin.php:307
msgid "Could not reach Dialogue. Check that your site can make outgoing connections and try again."
msgstr "לא הצלחנו להגיע ל-Dialogue. ודאו שהאתר יכול לבצע חיבורים יוצאים ונסו שוב."

#: includes/class-dialogue-wc-admin.php:308
msgid "Access was approved but Dialogue could not finish connecting. Please try again, or contact Dialogue support."
msgstr "הגישה אושרה אבל Dialogue לא הצליח להשלים את החיבור. נסו שוב או פנו לתמיכה של Dialogue."

#: includes/class-dialogue-wc-admin.php:309
msgid "This link has expired. Please click \"Connect to Dialogue\" again."
msgstr "תוקף הקישור פג. לחצו שוב על \"חיבור ל-Dialogue\"."

#: includes/class-dialogue-wc-admin.php:310
msgid "Your store was disconnected from Dialogue."
msgstr "החנות שלך נותקה מ-Dialogue."

#: includes/class-dialogue-wc-admin.php:311
msgid "Product import started. Changes show in Dialogue within a few minutes."
msgstr "ייבוא המוצרים התחיל. השינויים יופיעו ב-Dialogue תוך כמה דקות."

#: includes/class-dialogue-wc-admin.php:312
msgid "Could not start the product import. Please try again in a minute."
msgstr "לא ניתן להתחיל את ייבוא המוצרים. נסו שוב בעוד דקה."

#: includes/class-dialogue-wc-admin.php:342
msgid "Connected"
msgstr "מחובר"

#: includes/class-dialogue-wc-admin.php:344
msgid "Dialogue store ID"
msgstr "מזהה החנות ב-Dialogue"

#: includes/class-dialogue-wc-admin.php:346
msgid "Connected since"
msgstr "מחובר מאז"

#: includes/class-dialogue-wc-admin.php:349
msgid "Dialogue loads on your store automatically, your products stay in sync, and paid orders are counted toward Dialogue results. No customer names, emails or addresses are sent."
msgstr "Dialogue נטען בחנות אוטומטית, המוצרים נשארים מסונכרנים, והזמנות ששולמו נספרות בתוצאות של Dialogue. שמות, אימיילים וכתובות של לקוחות לא נשלחים."

#: includes/class-dialogue-wc-admin.php:351
msgid "Open Dialogue dashboard"
msgstr "פתיחת לוח הבקרה של Dialogue"

#: includes/class-dialogue-wc-admin.php:356
msgid "Sync products now"
msgstr "סנכרון מוצרים עכשיו"

#: includes/class-dialogue-wc-admin.php:358
msgid "Disconnect your store from Dialogue? Dialogue will stop showing on your store."
msgstr "לנתק את החנות מ-Dialogue? Dialogue יפסיק להופיע בחנות."

#: includes/class-dialogue-wc-admin.php:361
msgid "Disconnect"
msgstr "ניתוק"

#: includes/class-dialogue-wc-admin.php:364
msgid "Waiting for approval"
msgstr "ממתין לאישור"

#: includes/class-dialogue-wc-admin.php:364
msgid "Not connected"
msgstr "לא מחובר"

#: includes/class-dialogue-wc-admin.php:365
msgid "Connect your store to add Dialogue's AI shopping assistant, product recommendations, Reels and A/B tests. You will log in to Dialogue (or create an account), choose a plan, and approve read-only access on WooCommerce's own screen. Dialogue only reads your products and never changes your store."
msgstr "חברו את החנות כדי להוסיף את עוזר הקניות של Dialogue, המלצות מוצרים, רילס ובדיקות A/B. תתחברו ל-Dialogue (או תפתחו חשבון), תבחרו תוכנית ותאשרו גישת קריאה בלבד במסך של WooCommerce. Dialogue קורא רק את המוצרים ולעולם לא משנה את החנות."

#. translators: 1: terms URL, 2: privacy policy URL
#: includes/class-dialogue-wc-admin.php:371
#, php-format
msgid "By connecting you agree to Dialogue's <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">Terms of Service</a> and <a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">Privacy Policy</a>."
msgstr "בחיבור החנות אתם מסכימים ל<a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">תנאי השימוש</a> ול<a href=\"%2$s\" target=\"_blank\" rel=\"noopener noreferrer\">מדיניות הפרטיות</a> של Dialogue."

#: includes/class-dialogue-wc-admin.php:391
msgid "Connect to Dialogue"
msgstr "חיבור ל-Dialogue"

#: includes/class-dialogue-wc-admin.php:398
msgid "Recent activity"
msgstr "פעילות אחרונה"

#: includes/class-dialogue-wc-api-client.php:66
msgid "This store is not connected to Dialogue yet."
msgstr "החנות עדיין לא מחוברת ל-Dialogue."

#. translators: %d: HTTP status code
#: includes/class-dialogue-wc-api-client.php:107
#, php-format
msgid "Dialogue answered with an error (%d)."
msgstr "Dialogue החזיר שגיאה (%d)."

#. translators: 1: order number, 2: attempt, 3: error
#: includes/class-dialogue-wc-orders.php:101
#, php-format
msgid "Order %1$s was not sent to Dialogue (try %2$d), will retry: %3$s"
msgstr "הזמנה %1$s לא נשלחה ל-Dialogue (ניסיון %2$d), ננסה שוב: %3$s"

#. translators: 1: order number, 2: error
#: includes/class-dialogue-wc-orders.php:104
#, php-format
msgid "Order %1$s could not be sent to Dialogue after several tries: %2$s"
msgstr "לא ניתן היה לשלוח את הזמנה %1$s ל-Dialogue אחרי כמה ניסיונות: %2$s"

#: includes/class-dialogue-wc-plugin.php:70
msgid "Dialogue for WooCommerce needs WooCommerce to be installed and active."
msgstr "התוסף Dialogue ל-WooCommerce דורש ש-WooCommerce יהיה מותקן ופעיל."

#. translators: %s: error
#: includes/class-dialogue-wc-products.php:238
#, php-format
msgid "Product changes could not be sent to Dialogue after several tries; the nightly check will pick them up. Last error: %s"
msgstr "לא ניתן היה לשלוח שינויי מוצרים ל-Dialogue אחרי כמה ניסיונות; הבדיקה הלילית תעדכן אותם. שגיאה אחרונה: %s"

#. translators: 1: attempt, 2: error
#: includes/class-dialogue-wc-products.php:247
#, php-format
msgid "Product changes were not sent to Dialogue (try %1$d), will retry: %2$s"
msgstr "שינויי מוצרים לא נשלחו ל-Dialogue (ניסיון %1$d), ננסה שוב: %2$s"

#: includes/class-dialogue-wc-rest.php:123
msgid "Invalid signature."
msgstr "חתימה לא תקינה."

#: includes/class-dialogue-wc-rest.php:214
msgid "Dialogue disconnected this store."
msgstr "Dialogue ניתק את החנות."
